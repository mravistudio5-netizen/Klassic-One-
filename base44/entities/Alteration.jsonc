{
  "name": "Alteration",
  "type": "object",
  "properties": {
    "bill_number": {
      "type": "string",
      "title": "Bill Number"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "mobile_number": {
      "type": "string",
      "title": "Mobile Number"
    },
    "product": {
      "type": "string",
      "enum": [
        "Pant",
        "Shirt",
        "Jeans",
        "Kurta",
        "Blazer/Coat",
        "Other"
      ],
      "default": "Pant"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "alteration_note": {
      "type": "string",
      "title": "Alteration Note"
    },
    "voice_note_uri": {
      "type": "string",
      "title": "Voice Note URI"
    },
    "photo_uri": {
      "type": "string",
      "title": "Photo URI"
    },
    "time_limit_hours": {
      "type": "number",
      "enum": [
        1,
        2,
        5,
        15
      ],
      "default": 2
    },
    "status": {
      "type": "string",
      "enum": [
        "Received",
        "Completed",
        "Delivered"
      ],
      "default": "Received"
    },
    "store_id": {
      "type": "string",
      "title": "Store ID"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "title": "Received At (server time)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "title": "Delivered At"
    },
    "on_time": {
      "type": "boolean",
      "title": "Finished On Time"
    },
    "operator_id": {
      "type": "string",
      "title": "Operator ID"
    },
    "operator_name": {
      "type": "string",
      "title": "Operator Name"
    }
  },
  "required": [
    "bill_number",
    "customer_name",
    "product",
    "time_limit_hours",
    "store_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "tailoring_manager"
          }
        },
        {
          "user_condition": {
            "role": "tailoring_operator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "tailoring_manager"
          }
        },
        {
          "user_condition": {
            "role": "tailoring_operator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "tailoring_manager"
          }
        },
        {
          "user_condition": {
            "role": "tailoring_operator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}